{
  "id": "root_data.root_datum_from_reductive_group",
  "title": "Root Datum of a Reductive Group",
  "kind": "definition",
  "status": "admitted",
  "href": "AlgebraicGroups/RootData/root_data_root_datum_from_reductive_group.html",
  "primary_topic": "AlgebraicGroups.RootData",
